<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch screen = the activity theme's windowBackground (shown by the system before the first
  Compose frame): app background colour + the centred Mehrnaz sun mark. No SplashScreen API (API 29).
  The mark vector is a 108dp canvas whose sun spans ~56% of it, so 240dp gives a ~135dp sun.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">
    <item android:drawable="@color/background" />
    <item
        android:width="240dp"
        android:height="240dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
