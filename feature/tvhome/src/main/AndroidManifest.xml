<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        TvProvider's writePermission. Normal protection level: auto-granted at install, no prompt.
        androidx.tvprovider already merges it in; declared here so the requirement is explicit
        (see README.md).
    -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Package visibility on API 30+ (no effect on the API 29 TV): the system TvProvider authority. -->
    <queries>
        <provider android:authorities="android.media.tv" />
    </queries>
</manifest>
