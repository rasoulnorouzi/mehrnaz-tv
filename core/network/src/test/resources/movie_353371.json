6cc\u0627\u0631 \u062e\u0646\u062f\u0647\u200c\u062f\u0627\u0631 \u2014 \u062f\u0642\u06cc\u0642\u0627\u064b \u0647\u0645\u0627\u0646 \u0686\u06cc\u0632\u06cc \u06a9\u0647 \u0633\u06cc\u0646\u0645\u0627 \u0647\u0645 \u0628\u0627\u06cc\u062f \u0628\u0627\u0634\u062f.\n\n\u062f\u0627\u0633\u062a\u0627\u0646 \u06a9\u0645\u200c\u062a\u06a9\u0644\u06cc\u0641 \u0648 \u062e\u0637\u06cc \u0641\u06cc\u0644\u0645 \u062f\u0631 \u062e\u062f\u0645\u062a\u0650 \u0627\u062c\u0631\u0627\u06cc \u067e\u0634\u062a\u200c\u0633\u0631\u0650 \u0647\u0645 \u0634\u0644\u063a\u0645\u200c\u0647\u0627\u06cc \u0628\u062f\u0644 \u0628\u0647 \u0634\u0648\u062e\u06cc \u0627\u0633\u062a: \u0641\u0631\u0632\u0646\u062f \u06a9\u0627\u0631\u0622\u06af\u0627\u0647 \u0627\u0641\u0633\u0627\u0646\u0647\u200c\u0627\u06cc \u0641\u0631\u0627\u0646\u06a9 \u062f\u0631\u0628\u06cc\u0646 (\u062c\u0648\u0646\u06cc\u0648\u0631) \u0628\u0631\u0627\u06cc \u06a9\u0634\u0641 \u0645\u0631\u06af \u0645\u0631\u0645\u0648\u0632 \u06cc\u06a9 \u0646\u0627\u0628\u063a\u0647\u0654 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9 \u0648\u0627\u0631\u062f \u0645\u0627\u062c\u0631\u0627 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062f\u0631 \u0645\u0633\u06cc\u0631\u0634 \u0628\u0627 \u0628\u062a \u062f\u0650\u06cc\u0648\u0650\u0646\u067e\u0648\u0631\u062a (\u067e\u0645\u0644\u0627 \u0627\u0646\u062f\u0631\u0633\u0648\u0646) \u0647\u0645\u0631\u0627\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u062a\u0627 \u0646\u0642\u0634\u0647\u0654 \u0634\u06cc\u0637\u0627\u0646\u06cc \u0631\u06cc\u0686\u0627\u0631\u062f \u06a9\u06cc\u0640\u0646 \u2014 \u06a9\u0633\u06cc \u06a9\u0647 \u062f\u0633\u062a\u06af\u0627\u0647\u06cc \u062f\u0627\u0631\u062f \u06a9\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0622\u062f\u0645\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647\u200c\u0633\u0645\u062a\u0650 \u062e\u0634\u0648\u0646\u062a \u0648 \u062e\u0648\u062f\u0648\u06cc\u0631\u0627\u0646\u06af\u0631\u06cc \u0633\u0648\u0642 \u062f\u0647\u062f \u2014 \u0631\u0627 \u062e\u0646\u062b\u06cc \u06a9\u0646\u0646\u062f. \u0642\u0635\u0647 \u0627\u0633\u0627\u0633\u0627\u064b \u0627\u0628\u0632\u0627\u0631\u06cc \u0627\u0633\u062a \u0628\u0631\u0627\u06cc \u067e\u06cc\u0648\u0646\u062f \u062f\u0627\u062f\u0646 \u06cc\u06a9\u06cc \u067e\u0633 \u0627\u0632 \u062f\u06cc\u06af\u0631\u06cc \u0634\u0648\u062e\u06cc\u200c\u0647\u0627 \u0648 \u0646\u0645\u0627\u06cc\u200c\u0647\u0627\u06cc \u0627\u0628\u0632\u0648\u0631\u062f.\n\n\u0644\u06cc\u0627\u0645 \u0646\u06cc\u0633\u0648\u0646 \u0628\u0627 \u0627\u062c\u0631\u0627\u06cc \u062e\u0634\u06a9 \u0648 \u062c\u062f\u06cc\u200c\u0646\u0645\u0627\u06cc\u0627\u0646\u0647\u200c\u0627\u0634 \u0646\u0642\u0634 \u062f\u0631\u0628\u06cc\u0646\u0650 \u062c\u0648\u0627\u0646 \u0631\u0627 \u0628\u0647 \u0634\u06a9\u0644\u06cc \u0628\u0627\u0645\u0632\u0647 \u0627\u0632 \u0622\u0646\u0650 \u062e\u0648\u062f \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u0627\u0648 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062c\u0650\u062b\u0651\u0647\u0654 \u06af\u0650\u0631\u0627\u0648\u0644\u200c\u0635\u062f\u0627 \u0648 \u0648\u0642\u0627\u0631\u0650 \u062e\u0627\u0645\u0648\u0634\u0634\u060c \u0628\u0647\u200c\u0637\u0631\u0632\u06cc \u0645\u0648\u0641\u0642 \u0628\u0647 \u0645\u06cc\u0631\u0627\u062b\u0650 \u0644\u0632\u0644\u06cc \u0646\u06cc\u0644\u0633\u0646 \u0627\u062f\u0627\u06cc \u062f\u06cc\u0646 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u067e\u0645\u0644\u0627 \u0627\u0646\u062f\u0631\u0633\u0648\u0646 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0632\u0646 \u062c\u0630\u0627\u0628\u0650 \u062f\u0627\u0633\u062a\u0627\u0646 \u0635\u062d\u0646\u0647\u200c\u0647\u0627 \u0631\u0627 \u0645\u06cc\u200c\u062f\u0632\u062f\u062f\u061b \u0632\u0645\u0627\u0646\u200c\u0628\u0646\u062f\u06cc \u06a9\u0645\u062f\u06cc \u0627\u0648\u060c \u0628\u0647\u200c\u062e\u0635\u0648\u0635 \u062f\u0631 \u0633\u06a9\u0627\u0646\u0633\u200c\u0647\u0627\u06cc \u0639\u062c\u06cc\u0628 \u0645\u062b\u0644 \u0645\u0648\u0646\u062a\u0627\u0698 \u0622\u062f\u0645\u200c\u0628\u0631\u0641\u06cc \u0648 \u0628\u062e\u0634\u200c\u0647\u0627\u06cc\u06cc \u0628\u0627 \u0622\u0648\u0627\u0632\u0647\u0627\u06cc \u067e\u064e\u0631\u06a9\u0646\u0627\u0646\u060c \u0627\u0632 \u0646\u06a9\u0627\u062a \u0628\u0631\u062c\u0633\u062a\u0647\u200c\u0627\u0646\u062f. \u062f\u06cc\u06af\u0631 \u0628\u0627\u0632\u06cc\u06af\u0631\u0627\u0646 \u0646\u06cc\u0632 \u0628\u0627 \u062a\u0639\u0647\u062f \u06a9\u0627\u0645\u0644 \u0628\u0647 \u0641\u0636\u0627\u0633\u0627\u0632\u06cc \u0645\u0636\u062d\u06a9 \u0641\u06cc\u0644\u0645 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f \u062a\u0627 \u062c\u0645\u0639\u0650 \u0628\u0627\u0632\u06cc\u06af\u0631\u0627\u0646 \u0647\u0645\u0627\u0647\u0646\u06af \u0628\u0647\u200c\u0646\u0638\u0631 \u0628\u0631\u0633\u062f.\n\n\u0641\u06cc\u0644\u0645 \u067e\u0631 \u0627\u0632 \u062c\u0648\u06a9\u200c\u0647\u0627\u06cc \u067e\u06cc\u0627\u067e\u06cc \u0627\u0633\u062a: \u06a9\u0644\u0645\u0627\u062a\u200c\u0628\u0627\u0632\u06cc\u200c\u0647\u0627\u06cc \u0633\u0631\u06cc\u0639\u060c \u0634\u0648\u062e\u06cc\u200c\u0647\u0627\u06cc \u0645\u062a\u0627 \u0648 \u0627\u0633\u0644\u067e\u200c\u0627\u0633\u062a\u06cc\u06a9 \u0641\u06cc\u0632\u06cc\u06a9\u06cc (\u0645\u062b\u0644 \u06af\u0627\u0632 \u06af\u0631\u0641\u062a\u0646 \u0644\u0648\u0644\u0647\u0654 \u062a\u0641\u0646\u06af). \u0628\u0639\u0636\u06cc \u0627\u0632 \u0622\u0646\u200c\u0647\u0627 \u0648\u0627\u0642\u0639\u0627\u064b \u0628\u0627\u0645\u0632\u0647 \u0648 \u062e\u0644\u0627\u0642\u0627\u0646\u0647\u200c\u0627\u0646\u062f \u2014 \u0633\u06a9\u0627\u0646\u0633\u200c\u0647\u0627\u06cc \u0645\u0627\u062f\u0648\u0646\u200c\u0642\u0631\u0645\u0632\u060c \u0645\u0648\u0646\u062a\u0627\u0698 \u0631\u0645\u0627\u0646\u062a\u06cc\u06a9 \u0628\u0627 \u0622\u062f\u0645\u200c\u0628\u0631\u0641\u06cc \u0648 \u0635\u062d\u0646\u0647\u0654 \u0645\u0635\u06cc\u0628\